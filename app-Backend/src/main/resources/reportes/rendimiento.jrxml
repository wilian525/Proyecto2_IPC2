            <element kind="textField" x="0" y="61" width="90" height="28" style="Dificultad" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{cursoMayorDificultad} == null ? "" : String.valueOf($F{cursoMayorDificultad}.getIdCurso())]]></expression>
                <box><pen lineWidth="0.4" lineColor="#F4B6B6"/></box>
            </element>

            <element kind="textField" x="90" y="61" width="320" height="28" style="Dificultad" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{cursoMayorDificultad} == null ? "SIN DATOS" : $F{cursoMayorDificultad}.getCurso()]]></expression>
