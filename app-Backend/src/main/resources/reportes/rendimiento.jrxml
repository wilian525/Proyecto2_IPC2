                <box><pen lineWidth="0.5"/></box>
            </element>

            <element kind="textField" x="0" y="55" width="80" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{cursoMayorDificultad} == null ? "" : String.valueOf($F{cursoMayorDificultad}.getIdCurso())]]></expression>
                <box><pen lineWidth="0.5"/></box>
            </element>

            <element kind="textField" x="80" y="55" width="300" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{cursoMayorDificultad} == null ? "SIN DATOS" : $F{cursoMayorDificultad}.getCurso()]]></expression>
                <box><pen lineWidth="0.5"/></box>
            </element>

            <element kind="textField" x="380" y="55" width="140" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{cursoMayorDificultad} == null ? "" : String.format("%.2f", $F{cursoMayorDificultad}.getPromedio())]]></expression>
                <box><pen lineWidth="0.5"/></box>
            </element>

            <element kind="textField" x="520" y="55" width="282" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
