<?xml version="1.0" encoding="UTF-8"?>

<jasperReport name="historial_pagos"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail"
              uuid="7bf2f62d-23bf-4528-a337-83a65ab81101">

    <style name="Titulo" fontName="DejaVu Sans" fontSize="19" bold="true" forecolor="#FFFFFF" backcolor="#1F4E78" mode="Opaque"/>
    <style name="Subtitulo" fontName="DejaVu Sans" fontSize="11" bold="true" forecolor="#1F4E78"/>
    <style name="Encabezado" fontName="DejaVu Sans" fontSize="9" bold="true" forecolor="#FFFFFF" backcolor="#2F75B5" mode="Opaque"/>
    <style name="Celda" fontName="DejaVu Sans" fontSize="8" forecolor="#1F1F1F" backcolor="#F8FAFC" mode="Opaque"/>
    <style name="Total" fontName="DejaVu Sans" fontSize="9" bold="true" forecolor="#006100" backcolor="#C6EFCE" mode="Opaque"/>
    <style name="Pendiente" fontName="DejaVu Sans" fontSize="9" bold="true" forecolor="#9C0006" backcolor="#FFC7CE" mode="Opaque"/>

    <style name="Estado" fontName="DejaVu Sans" fontSize="9" bold="true" mode="Opaque">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{estadoCuenta} != null && $F{estadoCuenta}.equalsIgnoreCase("SOLVENTE")]]></conditionExpression>
            <style forecolor="#006100" backcolor="#C6EFCE"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{estadoCuenta} != null && $F{estadoCuenta}.equalsIgnoreCase("MOROSO")]]></conditionExpression>
            <style forecolor="#9C0006" backcolor="#FFC7CE"/>
        </conditionalStyle>
    </style>

    <dataset name="Pagos" uuid="7bf2f62d-23bf-4528-a337-83a65ab81102">
        <field name="idPago" class="java.lang.Integer"/>
        <field name="idEstudiante" class="java.lang.Integer"/>
        <field name="idEmpleado" class="java.lang.Integer"/>
        <field name="concepto" class="java.lang.String"/>
        <field name="monto" class="java.lang.Double"/>
        <field name="fecha" class="java.time.LocalDate"/>
    </dataset>

    <field name="idEstudiante" class="java.lang.Integer"/>
    <field name="estudiante" class="java.lang.String"/>
    <field name="fechaInicio" class="java.time.LocalDate"/>
    <field name="fechaFin" class="java.time.LocalDate"/>
    <field name="pagos" class="java.util.Collection"/>
    <field name="totalPagado" class="java.lang.Double"/>
    <field name="saldoPendiente" class="java.lang.Double"/>
    <field name="estadoCuenta" class="java.lang.String"/>

    <title height="145">

        <element kind="staticText" x="0" y="0" width="802" height="40" style="Titulo" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[HISTORIAL DE PAGOS DEL ESTUDIANTE]]></text>
        </element>

        <element kind="staticText" x="0" y="43" width="802" height="18" fontName="DejaVu Sans" fontSize="8" forecolor="#666666" hTextAlign="Center">
            <text><![CDATA[Detalle de pagos realizados y estado de cuenta]]></text>
        </element>

        <element kind="staticText" x="0" y="70" width="100" height="25" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[ID ESTUDIANTE]]></text>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="staticText" x="100" y="70" width="300" height="25" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[ESTUDIANTE]]></text>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="staticText" x="400" y="70" width="200" height="25" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[FECHA INICIO]]></text>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="staticText" x="600" y="70" width="202" height="25" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[FECHA FIN]]></text>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="textField" x="0" y="95" width="100" height="27" style="Celda" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$F{idEstudiante}]]></expression>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="textField" x="100" y="95" width="300" height="27" style="Celda" vTextAlign="Middle">
            <expression><![CDATA[$F{estudiante}]]></expression>
            <box leftPadding="5"><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="textField" x="400" y="95" width="200" height="27" style="Celda" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$F{fechaInicio} == null ? "TODOS LOS REGISTROS" : $F{fechaInicio}.toString()]]></expression>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

        <element kind="textField" x="600" y="95" width="202" height="27" style="Celda" hTextAlign="Center" vTextAlign="Middle">
            <expression><![CDATA[$F{fechaFin} == null ? "TODOS LOS REGISTROS" : $F{fechaFin}.toString()]]></expression>
            <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
        </element>

    </title>

    <detail>

        <band height="190" splitType="Stretch">

            <element kind="staticText" x="0" y="5" width="802" height="25" style="Subtitulo">
                <text><![CDATA[DETALLE DE PAGOS]]></text>
            </element>

            <element kind="component" x="0" y="35" width="802" height="145">
                <component kind="table">

                    <datasetRun subDataset="Pagos">
                        <dataSourceExpression><![CDATA[
                            new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource(
                                $F{pagos} == null ? java.util.Collections.emptyList() : $F{pagos}
                            )
                        ]]></dataSourceExpression>
                    </datasetRun>

                    <column kind="single" width="80">
                        <columnHeader height="28">
                            <element kind="staticText" width="80" height="28" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                                <text><![CDATA[ID PAGO]]></text>
                                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
                            </element>
                        </columnHeader>
                        <detailCell height="25">
                            <element kind="textField" width="80" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                                <expression><![CDATA[$F{idPago}]]></expression>
                                <box><pen lineWidth="0.4" lineColor="#D9E2F3"/></box>
                            </element>
                        </detailCell>
                    </column>

                    <column kind="single" width="100">
                        <columnHeader height="28">
                            <element kind="staticText" width="100" height="28" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                                <text><![CDATA[ID ESTUDIANTE]]></text>
                                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
                            </element>
                        </columnHeader>
                        <detailCell height="25">
                            <element kind="textField" width="100" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                                <expression><![CDATA[$F{idEstudiante}]]></expression>
                                <box><pen lineWidth="0.4" lineColor="#D9E2F3"/></box>
                            </element>
                        </detailCell>
                    </column>

                    <column kind="single" width="100">
                        <columnHeader height="28">
                            <element kind="staticText" width="100" height="28" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                                <text><![CDATA[SECRETARIA]]></text>
                                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
                            </element>
                        </columnHeader>
                        <detailCell height="25">
                            <element kind="textField" width="100" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                                <expression><![CDATA[$F{idEmpleado}]]></expression>
                                <box><pen lineWidth="0.4" lineColor="#D9E2F3"/></box>
                            </element>
                        </detailCell>
                    </column>

                    <column kind="single" width="240">
                        <columnHeader height="28">
                            <element kind="staticText" width="240" height="28" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                                <text><![CDATA[CONCEPTO]]></text>
                                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
                            </element>
                        </columnHeader>
                        <detailCell height="25">
                            <element kind="textField" width="240" height="25" style="Celda" vTextAlign="Middle">
                                <expression><![CDATA[$F{concepto}]]></expression>
                                <box leftPadding="5"><pen lineWidth="0.4" lineColor="#D9E2F3"/></box>
                            </element>
                        </detailCell>
                    </column>

                    <column kind="single" width="140">
                        <columnHeader height="28">
                            <element kind="staticText" width="140" height="28" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                                <text><![CDATA[MONTO]]></text>
                                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
                            </element>
                        </columnHeader>
                        <detailCell height="25">
                            <element kind="textField" width="140" height="25" style="Celda" pattern="Q #,##0.00" hTextAlign="Right" vTextAlign="Middle">
                                <expression><![CDATA[$F{monto}]]></expression>
                                <box rightPadding="6"><pen lineWidth="0.4" lineColor="#D9E2F3"/></box>
                            </element>
                        </detailCell>
                    </column>

                    <column kind="single" width="142">
                        <columnHeader height="28">
                            <element kind="staticText" width="142" height="28" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                                <text><![CDATA[FECHA]]></text>
                                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
                            </element>
                        </columnHeader>
                        <detailCell height="25">
                            <element kind="textField" width="142" height="25" style="Celda" hTextAlign="Center" vTextAlign="Middle">
                                <expression><![CDATA[$F{fecha} == null ? "" : $F{fecha}.toString()]]></expression>
                                <box><pen lineWidth="0.4" lineColor="#D9E2F3"/></box>
                            </element>
                        </detailCell>
                    </column>

                </component>
            </element>

        </band>

        <band height="120">

            <element kind="staticText" x="0" y="5" width="802" height="25" style="Subtitulo">
                <text><![CDATA[RESUMEN DEL ESTADO DE CUENTA]]></text>
            </element>

            <element kind="staticText" x="0" y="35" width="267" height="27" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                <text><![CDATA[TOTAL PAGADO]]></text>
                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
            </element>

            <element kind="staticText" x="267" y="35" width="267" height="27" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                <text><![CDATA[SALDO PENDIENTE]]></text>
                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
            </element>

            <element kind="staticText" x="534" y="35" width="268" height="27" style="Encabezado" hTextAlign="Center" vTextAlign="Middle">
                <text><![CDATA[ESTADO]]></text>
                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
            </element>

            <element kind="textField" x="0" y="62" width="267" height="32" style="Total" pattern="Q #,##0.00" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{totalPagado}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#A9D08E"/></box>
            </element>

            <element kind="textField" x="267" y="62" width="267" height="32" style="Pendiente" pattern="Q #,##0.00" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{saldoPendiente}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#F4B6B6"/></box>
            </element>

            <element kind="textField" x="534" y="62" width="268" height="32" style="Estado" hTextAlign="Center" vTextAlign="Middle">
                <expression><![CDATA[$F{estadoCuenta}]]></expression>
                <box><pen lineWidth="0.5" lineColor="#D9E2F3"/></box>
            </element>

        </band>

    </detail>

    <pageFooter height="30">

        <element kind="staticText" x="0" y="8" width="250" height="18" fontName="DejaVu Sans" fontSize="7" forecolor="#777777">
            <text><![CDATA[Sistema de Administración Escolar]]></text>
        </element>

        <element kind="textField" x="652" y="8" width="150" height="18" fontName="DejaVu Sans" fontSize="8" forecolor="#555555" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
        </element>

    </pageFooter>

    <noData height="60">
        <element kind="staticText" x="0" y="15" width="802" height="30" fontName="DejaVu Sans" fontSize="11" bold="true" forecolor="#666666" backcolor="#F2F2F2" mode="Opaque" hTextAlign="Center" vTextAlign="Middle">
            <text><![CDATA[No existen pagos para los filtros seleccionados.]]></text>
        </element>
    </noData>

</jasperReport>